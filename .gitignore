# ============================================================
# SparkShield — .gitignore
# ============================================================

# ── Raw dataset (never commit — ~1 GB) ──────────────────────
data/raw/
*.csv
*.pcap

# ── Processed data and model artifacts ──────────────────────
data/processed/
models/

# ── Build outputs ────────────────────────────────────────────
target/
scala/target/
scala/project/target/
scala/project/project/
*.class
*.jar
sparkshield-assembly-*.jar

# ── sbt ──────────────────────────────────────────────────────
.sbt/
.bsp/

# ── Spark logs / checkpoints / generated outputs ────────────
spark-warehouse/
derby.log
metastore_db/
checkpoints/
results/streaming/
results/streaming-ml/
results/ml/
results/sql-analytics/
results/graph-analytics/
results/logs/
results/metrics/*.json
results/metrics/*.csv

# ── Python virtualenv & caches ───────────────────────────────
pyspark/.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ── Dashboard transient files ────────────────────────────────
dashboard/*.log
dashboard/.dashboard.pid

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ──────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.metals/
.bloop/

# ── Docker volumes / Kafka data ──────────────────────────────
kafka/data/

# ── Environment secrets ──────────────────────────────────────
.env
*.env.local
secrets/
